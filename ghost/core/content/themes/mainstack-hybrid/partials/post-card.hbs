<article class="post-card {{post_class}}">
    {{#if feature_image}}
        <a class="post-card-media" href="{{url}}">
            <img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        </a>
    {{/if}}
    <div class="post-card-body">
        <h3 class="post-card-title"><a href="{{url}}">{{title}}</a></h3>
        <p class="post-card-excerpt">{{excerpt words="24"}}</p>
        <p class="post-card-meta">
            {{authors separator=", "}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
        </p>
    </div>
</article>
