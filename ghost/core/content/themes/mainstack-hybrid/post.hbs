{{!< default}}

{{!--
    Article page. Title and meta sit above the cover, not on it.
    There is no search control on the cover, no comments, no drop cap,
    no previous/next links, and no second share row. The only share
    actions sit under the newsletter in the rail.
--}}
{{#post}}
<article class="article {{post_class}}">
    <header class="article-header">
        <h1>{{title}}</h1>
        <p class="article-meta">
            {{authors}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
            {{#if reading_time}}<span>{{reading_time}}</span>{{/if}}
        </p>
    </header>

    {{#if feature_image}}
        <figure class="article-image">
            <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}
                <figcaption>{{feature_image_caption}}</figcaption>
            {{/if}}
        </figure>
    {{/if}}

    <div class="article-layout">
        {{> "toc"}}
        <section class="gh-content">
            {{content}}
        </section>
        <aside class="article-rail">
            {{> "newsletter"}}
            {{> "socials"}}
        </aside>
    </div>
</article>

{{> "related-posts"}}
{{/post}}

{{#contentFor "scripts"}}
    <script src="{{asset "js/article.js"}}"></script>
{{/contentFor}}
