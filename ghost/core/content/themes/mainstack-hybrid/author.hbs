{{!< default}}

{{#author}}
<header class="archive-header">
    {{#if profile_image}}
        <img class="archive-avatar" src="{{img_url profile_image size="s"}}" alt="">
    {{/if}}
    <h1>{{name}}</h1>
    {{#if bio}}
        <p>{{bio}}</p>
    {{/if}}
</header>
{{/author}}

<section class="post-list" aria-label="Author posts">
    {{> "post-feed"}}
</section>
