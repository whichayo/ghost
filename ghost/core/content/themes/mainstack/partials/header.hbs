<header class="site-header">
    <div class="site-header-inner">
        {{!-- TODO(MSC): replace this single bar with two sticky navs. Stubs: site-nav, blog-nav. --}}
        {{> "site-nav"}}
        <a class="site-logo" href="{{@site.url}}">{{@site.title}}</a>
        {{> "blog-nav"}}
        <nav class="site-nav" aria-label="Primary">
            {{#foreach navigation}}
                <a href="{{url absolute="true"}}"{{#if current}} class="is-current"{{/if}}>{{label}}</a>
            {{/foreach}}
        </nav>
    </div>
</header>
