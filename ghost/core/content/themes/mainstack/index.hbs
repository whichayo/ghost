{{!< default}}

{{!--
    Homepage scaffold only. Later tickets fill the redesign sections:
    featured announcements, CTA, videos, and category blocks.
    Intended hero copy, when that ticket lands:
    H1 "The Mainstack Blog"
    Subheading "Guides, Conversations with Creators, Tools, Templates and everything else in between to help you monetize your knowledge."
--}}

{{#is "home"}}
<section class="home-intro">
    <h1>{{@site.title}}</h1>
    {{#if @site.description}}
        <p class="home-intro-text">{{@site.description}}</p>
    {{/if}}
    {{> "featured"}}
</section>
{{/is}}

<section class="post-list" aria-label="{{#is "home"}}Latest posts{{else}}Posts{{/is}}">
    <h2 class="section-title">{{#is "home"}}Latest{{else}}Posts{{/is}}</h2>
    {{> "post-feed"}}
</section>
